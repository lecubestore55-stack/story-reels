# ---- Login (one admin) ----
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=paste-a-random-64-char-string
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# ---- API keys ----
FAL_KEY=                 # https://fal.ai/dashboard/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=       # https://console.anthropic.com/settings/keys

# ---- Database ----
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}   (docker-compose sets it for you)
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://reels:change-me@localhost:5432/reels   # only when running without Docker
# DATA_DIR=./data    # the Docker image uses /data (mount your volume there)

# ---- Models (change here when new versions come out) ----
GEMINI_MODEL=gemini-3.8-flash
CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MODEL=claude-haiku-5-5   # cheaper writer
FAL_IMAGE_MODEL=fal-ai/nano-banana-2
FAL_IMAGE_EDIT_MODEL=fal-ai/nano-banana-2/edit
FAL_IMAGE_PRICE_USD=0.08
FAL_IMAGE_LITE_MODEL=google/nano-banana-lite/edit
FAL_IMAGE_LITE_PRICE_USD=0.05
FAL_VEO_LITE_ENDPOINT=fal-ai/veo3.1/lite/image-to-video
FAL_KLING25_ENDPOINT=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
FAL_KLING3_TURBO_ENDPOINT=fal-ai/kling-video/v3/turbo/standard/image-to-video
FAL_KLING_ENDPOINT=fal-ai/kling-video/v3/pro/image-to-video
FAL_VEO_ENDPOINT=fal-ai/veo3.1/image-to-video

# ---- Worker ----
WORKER_CONCURRENCY=2
# MOCK_AI=1 runs everything with fake AI + placeholder media (free, for testing)
MOCK_AI=0
